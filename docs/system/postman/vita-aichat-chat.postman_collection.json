{
  "info": {
    "name": "vita-aichat-chat",
    "_postman_id": "a5f71aa6-3904-4f7a-b44c-6cf0d4c0cf9c",
    "description": "正式 Chat 接口联调集合，仅覆盖 /chat/**。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:19003/aichat/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "创建会话",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"新对话\",\n  \"systemPrompt\": \"你是一个严谨的开发助手。\",\n  \"modelCode\": \"qwen-plus\",\n  \"temperature\": 0.7,\n  \"maxTokens\": 4096,\n  \"maxContextMessages\": 12\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/conversations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "conversations"
          ]
        }
      }
    },
    {
      "name": "分页查询会话",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/chat/conversations?pageNum=1&pageSize=10&keyword=",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "conversations"
          ],
          "query": [
            {
              "key": "pageNum",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "10"
            },
            {
              "key": "keyword",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "name": "查询会话详情",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/chat/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    },
    {
      "name": "重命名会话",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"重命名后的会话\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/conversations/{{conversationId}}/title",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "conversations",
            "{{conversationId}}",
            "title"
          ]
        }
      }
    },
    {
      "name": "删除会话",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/chat/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    },
    {
      "name": "分页查询消息",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/chat/conversations/{{conversationId}}/messages?pageNum=1&pageSize=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "conversations",
            "{{conversationId}}",
            "messages"
          ],
          "query": [
            {
              "key": "pageNum",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "发送消息",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"请总结当前会话的关键上下文。\",\n  \"messageType\": \"TEXT\",\n  \"useContext\": 1,\n  \"requestId\": \"chat-postman-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/conversations/{{conversationId}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "conversations",
            "{{conversationId}}",
            "messages"
          ]
        }
      }
    },
    {
      "name": "流式发送消息",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"请以流式方式回答这个问题。\",\n  \"messageType\": \"TEXT\",\n  \"useContext\": 1,\n  \"requestId\": \"chat-stream-postman-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/conversations/{{conversationId}}/messages/stream",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "conversations",
            "{{conversationId}}",
            "messages",
            "stream"
          ]
        }
      }
    }
  ]
}
