<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.vita</groupId>
        <artifactId>be-vita</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vita-starters</artifactId>
    <name>vita-starters</name>
    <packaging>pom</packaging>
    <description>Starters Spring Boot</description>

    <modules>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <vita.starters.version>1.0.0-SNAPSHOT</vita.starters.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 验证码 Starter -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-captcha-spring-boot-starter</artifactId>
                <version>${vita.starters.version}</version>
            </dependency>
            <!-- 文件上传/存储 Starter -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-file-spring-boot-starter</artifactId>
                <version>${vita.starters.version}</version>
            </dependency>
            <!-- 国际化 Starter -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-i18n-spring-boot-starter</artifactId>
                <version>${vita.starters.version}</version>
            </dependency>
            <!-- Excel/文档处理 Starter -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-poi-spring-boot-starter</artifactId>
                <version>${vita.starters.version}</version>
            </dependency>
            <!-- AI Core Starter -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-ai-core-spring-boot-starter</artifactId>
                <version>${vita.starters.version}</version>
            </dependency>
            <!-- DashScope AI Provider Starter -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-ai-provider-spring-boot-starter</artifactId>
                <version>${vita.starters.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>starter-captcha</id>
            <modules>
                <module>vita-captcha-spring-boot-starter</module>
            </modules>
        </profile>
        <profile>
            <id>starter-file</id>
            <modules>
                <module>vita-file-spring-boot-starter</module>
            </modules>
        </profile>
        <profile>
            <id>starter-i18n</id>
            <modules>
                <module>vita-i18n-spring-boot-starter</module>
            </modules>
        </profile>
        <profile>
            <id>starter-poi</id>
            <modules>
                <module>vita-poi-spring-boot-starter</module>
            </modules>
        </profile>
        <profile>
            <id>starter-ai-core</id>
            <modules>
                <module>vita-ai-core-spring-boot-starter</module>
                <module>vita-ai-provider-spring-boot-starter</module>
            </modules>
        </profile>
        <profile>
            <id>starter-ai</id>
            <modules>
                <module>vita-ai-core-spring-boot-starter</module>
                <module>vita-ai-provider-spring-boot-starter</module>
            </modules>
        </profile>
        <profile>
            <id>starter-all</id>
            <modules>
                <module>vita-captcha-spring-boot-starter</module>
                <module>vita-file-spring-boot-starter</module>
                <module>vita-i18n-spring-boot-starter</module>
                <module>vita-poi-spring-boot-starter</module>
                <module>vita-ai-core-spring-boot-starter</module>
                <module>vita-ai-provider-spring-boot-starter</module>
            </modules>
        </profile>
    </profiles>
</project>
