package ${package.ServiceImpl};

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.baomidou.mybatisplus.extension.plugins.pagination.Page;
import ${commonPackage}.exception.GlobalErrorCode;
import ${commonPackage}.exception.ServiceException;
import ${commonPackage}.page.PageResponse;
import ${dtoPackage}.${entity}CreateDto;
import ${dtoPackage}.${entity}SearchDto;
import ${dtoPackage}.${entity}UpdateDto;
import ${package.Entity}.${entity};
import ${package.Mapper}.${table.mapperName};
import ${package.Service}.${table.serviceName};
import ${superServiceImplClassPackage};
import org.springframework.beans.BeanUtils;
import org.springframework.stereotype.Service;
import org.springframework.util.StringUtils;

import java.util.List;

/**
 * @BelongsProject: ${projectName}
 * @BelongsPackage: ${package.ServiceImpl}
 * @Author ${author}
 * @CreateTime ${date}
 * @Description: ${table.comment} Service 实现
 * @version 1.0
 */
@Service
#if(${kotlin})
open class ${table.serviceImplName} : ${superServiceImplClass}<${table.mapperName}, ${entity}>(), ${table.serviceName} {

}
#else
public class ${table.serviceImplName} extends ${superServiceImplClass}<${table.mapperName}, ${entity}> implements ${table.serviceName} {

    /**
     * 新增数据并返回主键ID。
     *
     * @param createDto 创建请求对象
     * @return 新增记录ID
     */
    @Override
    public Long create(${entity}CreateDto createDto) {
        if (createDto == null) {
            throw new ServiceException(GlobalErrorCode.BAD_REQUEST);
        }
        ${entity} data = new ${entity}();
        BeanUtils.copyProperties(createDto, data);
        save(data);
        return data.getId();
    }

    /**
     * 更新指定数据。
     *
     * @param updateDto 更新请求对象
     */
    @Override
    public void update(${entity}UpdateDto updateDto) {
        if (updateDto == null || updateDto.getId() == null) {
            throw new ServiceException(GlobalErrorCode.BAD_REQUEST);
        }
        getRequiredEntity(updateDto.getId());
        ${entity} data = new ${entity}();
        BeanUtils.copyProperties(updateDto, data);
        updateById(data);
    }

    /**
     * 删除指定数据。
     *
     * @param id 主键ID
     */
    @Override
    public void delete(Long id) {
        getRequiredEntity(id);
        removeById(id);
    }

    /**
     * 查询单条数据。
     *
     * @param id 主键ID
     * @return 实体对象
     */
    @Override
    public ${entity} get(Long id) {
        return getRequiredEntity(id);
    }

    /**
     * 列表查询。
     *
     * @param searchDto 查询条件
     * @return 实体列表
     */
    @Override
    public List<${entity}> list(${entity}SearchDto searchDto) {
        return list(buildQueryWrapper(searchDto));
    }

    /**
     * 分页查询。
     *
     * @param searchDto 分页查询条件
     * @return 分页实体结果
     */
    @Override
    public PageResponse<${entity}> page(${entity}SearchDto searchDto) {
        if (searchDto == null) {
            searchDto = new ${entity}SearchDto();
        }
        Page<${entity}> mpPage = Page.of(searchDto.getPageNum(), searchDto.getPageSize());
        Page<${entity}> result = page(mpPage, buildQueryWrapper(searchDto));
        return new PageResponse<>(result.getRecords(), result.getTotal());
    }

    /**
     * 构造列表查询条件。
     *
     * @param searchDto 查询条件
     * @return 查询条件构造器
     */
    private LambdaQueryWrapper<${entity}> buildQueryWrapper(${entity}SearchDto searchDto) {
        LambdaQueryWrapper<${entity}> queryWrapper = new LambdaQueryWrapper<>();
        if (searchDto != null && StringUtils.hasText(searchDto.getKeyword())) {
            // TODO 根据业务字段补充关键字查询条件
        }
        queryWrapper.orderByDesc(${entity}::getId);
        return queryWrapper;
    }

    /**
     * 查询并校验数据存在性。
     *
     * @param id 主键ID
     * @return 实体对象
     */
    private ${entity} getRequiredEntity(Long id) {
        if (id == null) {
            throw new ServiceException(GlobalErrorCode.BAD_REQUEST);
        }
        ${entity} data = getById(id);
        if (data == null) {
            throw new ServiceException(GlobalErrorCode.NOT_FOUND);
        }
        return data;
    }
}
#end
